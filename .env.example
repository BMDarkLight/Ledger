# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ledger

# ---- Retrieval ----
RETRIEVAL_TOP_K=10
RERANK_TOP_N=4
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Tools ----
# Leave blank to disable the web_search tool.
WEB_SEARCH_API_KEY=

# ---- Behavior ----
# Minimum share of factual sentences that must carry a receipt before an
# answer is returned as "verified" rather than "unverified".
CITATION_COVERAGE_FLOOR=1.0
