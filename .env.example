# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Embeddings (local, via fastembed — no key needed) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Qdrant ----
# Use ":memory:" to run the store in-process (tests, CI, quick local runs).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ledger

# ---- Retrieval ----
RETRIEVAL_TOP_K=10
RERANK_TOP_N=4
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where ONNX model files live. Blank uses fastembed's temp-dir default.
MODEL_CACHE_DIR=

# ---- Tools ----
# Leave blank to disable the web_search tool.
WEB_SEARCH_API_KEY=

# ---- Behavior ----
# Minimum share of factual sentences that must carry a receipt before an
# answer is returned as "verified" rather than "unverified".
CITATION_COVERAGE_FLOOR=1.0
